# Jarvis v2 local configuration. Copy to .env and adjust if needed.
# Defaults are designed for a single Linux desktop user.

JARVIS_HOST=127.0.0.1
JARVIS_PORT=3081
JARVIS_DATA_DIR=~/.local/share/jarvis/data

# Local model runtime (Ollama)
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_LLM_MODEL=qwen2.5:3b
JARVIS_VISION_MODEL=qwen2.5vl:3b
JARVIS_EMBED_MODEL=nomic-embed-text

# Local speech / OCR
# faster-whisper is the default; whisper.cpp is kept as an offline fallback.
JARVIS_ASR_ENGINE=faster-whisper
JARVIS_ASR_MODEL=tiny
JARVIS_PYTHON=python3
JARVIS_WHISPER_BIN=~/.local/share/jarvis/src/whisper.cpp/build/bin/whisper-cli
JARVIS_WHISPER_MODEL=~/.local/share/jarvis/models/ggml-small.bin
JARVIS_PIPER_BIN=~/.local/share/jarvis/src/piper/piper/piper
JARVIS_PIPER_VOICE=~/.local/share/jarvis/models/zh_CN-huayan-medium.onnx
JARVIS_FFMPEG=ffmpeg
JARVIS_ARECORD=arecord

# Remote access: leave empty for loopback only. Set a long random token and a
# private host (e.g. Tailscale IP) to allow phone/PWA access.
JARVIS_AUTH_TOKEN=
JARVIS_TLS_CERT=
JARVIS_TLS_KEY=

# Optional behavior
JARVIS_QUIET_START=22:00
JARVIS_QUIET_END=08:00
JARVIS_DAILY_SPEAK_BUDGET=5
JARVIS_SCREEN_TIMEOUT_MS=15000
JARVIS_SCREEN_BLOCKLIST=1password,bitwarden,keepass,银行,网银,密码