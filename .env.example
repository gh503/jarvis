DEEPSEEK_API_KEY=replace-with-your-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# JARVIS_PORT=3080
# JARVIS_DATA_DIR=/absolute/path/to/private/jarvis-data
# JARVIS_GATEWAY_HOST=127.0.0.1
# JARVIS_DEVICE_COMMAND_TOKEN=use-a-separate-local-secret-of-at-least-16-characters
# JARVIS_DEVICE_GATEWAY_URL=http://127.0.0.1:3090
# JARVIS_HOME_ASSISTANT_URL=wss://home-assistant.example/api/websocket
# JARVIS_HOME_ASSISTANT_TOKEN=keep-this-local-and-uncommitted
# JARVIS_HOME_ASSISTANT_COMMAND_TIMEOUT_MS=10000
# JARVIS_MQTT_URL=mqtts://broker.example:8883
# JARVIS_MQTT_USERNAME=device-scoped-user
# JARVIS_MQTT_PASSWORD=keep-this-local-and-uncommitted
# JARVIS_MQTT_CLIENT_ID=jarvis-mac-mqtt
# JARVIS_HARNESS_URL=http://127.0.0.1:3080
# JARVIS_HARNESS_TIMEOUT_MS=10000
# JARVIS_GATEWAY_TLS_KEY=/absolute/path/to/private/tls-key.pem
# JARVIS_GATEWAY_TLS_CERT=/absolute/path/to/tls-certificate-chain.pem
# JARVIS_SESSION_STATE=/absolute/path/to/private/session-state.json
# JARVIS_EVENT_STATE=/absolute/path/to/private/event-state.json
# JARVIS_PWA_ROOT=/absolute/path/to/jarvis/web
