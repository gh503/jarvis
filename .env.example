# Jarvis v2 local configuration. Copy to .env and adjust if needed.
# Defaults are designed for a single Linux desktop user.

JARVIS_HOST=127.0.0.1
JARVIS_PORT=3081
JARVIS_DATA_DIR=~/.local/share/jarvis/data

# Local model runtime (Ollama)
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_LLM_MODEL=qwen2.5:3b
JARVIS_VISION_MODEL=qwen2.5vl:3b
JARVIS_EMBED_MODEL=nomic-embed-text
# Keep the desktop assistant warm between turns; use 5m to save RAM.
JARVIS_OLLAMA_KEEP_ALIVE=24h

# Local speech / OCR
# faster-whisper is the default; whisper.cpp is kept as an offline fallback.
JARVIS_ASR_ENGINE=faster-whisper
JARVIS_ASR_MODEL=tiny
JARVIS_PYTHON=python3
JARVIS_WHISPER_BIN=~/.local/share/jarvis/src/whisper.cpp/build/bin/whisper-cli
JARVIS_WHISPER_MODEL=~/.local/share/jarvis/models/ggml-small.bin
JARVIS_PIPER_BIN=~/.local/share/jarvis/src/piper/piper/piper
JARVIS_PIPER_VOICE=~/.local/share/jarvis/models/zh_CN-huayan-medium.onnx
JARVIS_FFMPEG=ffmpeg
JARVIS_ARECORD=arecord
# Optional: Edge TTS command used when TTS provider = edge (pip install --user edge-tts)
# JARVIS_EDGE_TTS_BIN=edge-tts

# Remote access: leave empty for loopback only. Set a long random token and a
# private host (e.g. Tailscale IP) to allow phone/PWA access.
JARVIS_AUTH_TOKEN=
JARVIS_TLS_CERT=
JARVIS_TLS_KEY=

# Optional behavior
JARVIS_QUIET_START=22:00
JARVIS_QUIET_END=08:00
JARVIS_DAILY_SPEAK_BUDGET=5
JARVIS_SCREEN_TIMEOUT_MS=15000
JARVIS_SCREEN_BLOCKLIST=1password,bitwarden,keepass,银行,网银,密码
# LLM 来源（本地 Ollama / 远端 Chat Completions / Responses / Anthropic）
# 在 Web 设置里切换并持久化到 data/model-config.json；模型列表自动发现。
# 下面的 JARVIS_OLLAMA_* 是 local profile 的默认值。
# ASR/TTS 本地/远端切换在 Web 设置里，持久化到 data/voice-config.json。
# 远端 ASR/TTS 支持 OpenAI 兼容、Gemini、Cloudflare 与 Edge；协议见 docs/voice.md。
# 效果与行为参数（界面/对话/记忆/声音/打扰）由 Studio 调参页管理，
# 持久化到 data/tuning.json（0600）；这里的 quiet/budget/screen 是首次启动默认值。
# 端口、TLS、认证令牌、模型 API Key 仍然只能由本文件 / 模型设置控制。

# Camera device (default /dev/video0)
JARVIS_CAMERA_DEVICE=/dev/video0

# Local daily brief time (24h, Asia/Shanghai local time)
JARVIS_BRIEF_TIME=08:30

# Optional read-only iCalendar file (GNOME Calendar export / calendar.ics)
# JARVIS_CALENDAR_ICS=/home/you/calendar.ics

# Desktop notifications (set 0 to disable)
JARVIS_NOTIFY=1

# ---------------------------------------------------------------------------
# 网络与隐私开关
# ---------------------------------------------------------------------------
# Host 白名单：默认只接受 localhost / 127.0.0.1 / [::1] 以及 JARVIS_HOST 本身。
# 用域名或局域网地址访问时把名字加进来（逗号分隔），否则会被 421 拒绝。
# 这是防 DNS rebinding 的边界，不要为了省事改成通配。
# JARVIS_ALLOWED_HOSTS=jarvis.lan,192.168.1.20

# 允许把屏幕/摄像头画面发给远端模型（默认关闭；开启前确认服务商政策）。
# JARVIS_ALLOW_REMOTE_VISION=1

# 日志级别：debug / info / warn / error（默认 info）
# JARVIS_LOG_LEVEL=info

# 覆盖静态资源目录（默认仓库内 web/）
# JARVIS_WEB_DIR=/path/to/web

# 提醒触发时执行的通知命令（可选）
# JARVIS_NOTIFY_COMMAND=/home/you/bin/notify.sh

# 覆盖 ASR / OCR worker 脚本路径（默认仓库 scripts/ 下）
# JARVIS_ASR_SCRIPT=/home/you/scripts/asr_worker.py
# JARVIS_OCR_SCRIPT=/home/you/scripts/ocr_worker.py
