{
  "name": "jarvis",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first Linux Jarvis assistant: voice, memory, screen/camera context, Studio and PWA",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --experimental-transform-types --enable-source-maps src/main.ts",
    "dev": "node --watch --experimental-transform-types src/main.ts",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "node --experimental-transform-types src/doctor.ts",
    "setup": "bash scripts/setup-models.sh",
    "migrate-v1": "node --experimental-transform-types src/cli.ts migrate-v1",
    "memory": "node --experimental-transform-types src/cli.ts memory",
    "acceptance": "bash scripts/acceptance.sh",
    "memory:eval": "node --experimental-transform-types scripts/memory-eval.ts",
    "backup": "node --experimental-transform-types scripts/backup.ts",
    "restore": "node --experimental-transform-types scripts/restore.ts",
    "ui:smoke": "node --experimental-transform-types scripts/ui-smoke.ts",
    "acceptance:full": "node --experimental-transform-types scripts/acceptance-full.ts",
    "app": "node --experimental-transform-types scripts/app.ts",
    "package": "node --experimental-transform-types scripts/package-app.ts",
    "native:build": "node --experimental-transform-types scripts/build-native-helper.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.20.0",
    "tar": "7.5.22",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
