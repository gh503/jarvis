{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first Jarvis MVP for macOS, powered by DeepSeek Harness",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "start": "./scripts/start-mac.sh",
    "start:gateway": "./scripts/start-gateway.sh",
    "backup": "npm run build --silent && node dist/backup-main.js backup",
    "restore": "npm run build --silent && node dist/backup-main.js restore",
    "pair:node": "npm run build --silent && node dist/node-pairing-main.js",
    "pair:approve": "npm run build --silent && node dist/pairing-approval-main.js",
    "verify": "npm run typecheck && npm test",
    "verify:runtime": "./scripts/verify-local-runtime.sh",
    "check:gateway": "./scripts/check-private-gateway.sh",
    "verify:release": "./scripts/verify-release-macos.sh",
    "release:archive": "./scripts/build-release-archive.sh"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "mqtt": "5.15.2",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/ws": "8.18.1",
    "typescript": "6.0.3"
  }
}
